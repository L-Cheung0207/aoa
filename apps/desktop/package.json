{
  "name": "@voice/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "node scripts/dist-win.mjs",
    "dist:payload": "electron-builder --win nsis --config electron-builder.yml",
    "dist:installer-shell": "node scripts/dist-win.mjs --installer-shell",
    "dist:win": "pnpm run dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@voice/ai": "workspace:*",
    "@voice/backend-client": "workspace:*",
    "@voice/native-helper": "workspace:*",
    "@voice/shared": "workspace:*",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.8.3",
    "https-proxy-agent": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.2.0",
    "ws": "^8.20.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "electron": "^35.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ctm.voice-assistant",
    "productName": "Voice Assistant",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist-electron",
      "buildResources": "installer-resources"
    },
    "electronDist": "../../node_modules/electron/dist",
    "electronVersion": "35.7.5",
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/@voice/ai/**",
      "!node_modules/@voice/shared/**",
      "!node_modules/@voice/backend-client/**",
      "!node_modules/@voice/db/**"
    ],
    "extraResources": [
      {
        "from": "resources/app-icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "src/renderer/public/config.json",
        "to": "config.json"
      },
      {
        "from": "../../packages/native-helper/dist/voice_native_helper.node",
        "to": "voice_native_helper.node"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/app-icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Voice Assistant",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "include": "installer.nsh",
      "installerLanguages": [
        "zh_TW"
      ],
      "language": "1028",
      "runAfterFinish": false
    }
  }
}
