{
  "name": "voice-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm --filter @voice/desktop dev",
    "build": "pnpm -r build",
    "dist": "pnpm build && pnpm --filter @voice/desktop dist",
    "dist:mac": "pnpm --filter @voice/desktop dist:mac",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.2",
    "vitest": "^3.1.2"
  }
}
