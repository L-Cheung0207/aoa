{
  "name": "@voice/native-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cargo build --features node-addon && node scripts/copy-node-addon.mjs",
